<!--
  FrameLine shared look (owner: shell). Merged into Application.Resources by App.xaml.
  ThemeManager replaces every FL.* BRUSH below at runtime (light/dark), so always reference them
  with {DynamicResource ...}. The values written here are the dark defaults (the app default theme).

  Brushes (theme-dependent)
    FL.WindowBackground        window background
    FL.SurfaceBackground       grouped card / section background (Form "grouped" look)
    FL.SurfaceBorder           hairline around cards, popups, menus
    FL.ControlBackground       button / combo face
    FL.ControlHoverBackground  button / combo / list hover
    FL.ControlBorder           button / combo border
    FL.TextPrimary             main text
    FL.TextSecondary           secondary text (labels, footers, shortcut hints)
    FL.TextTertiary            least important text (copyright)
    FL.Separator               menu / section separators
    FL.MenuBackground          context-menu surface
    FL.MenuHover               highlighted menu item
    FL.Accent                  system-like accent (switch on, selected item, default button)
    FL.AccentText              text on FL.Accent
    FL.SwitchOffTrack          toggle switch track when off
  Brushes (fixed, same in both themes; GlassUI.swift brand palette + logo red)
    FL.Ink #131313   FL.Mid #9A9A9A   FL.Light #F2F2F2   FL.Danger #FF453A   FL.Success #6BD46A
  Fonts
    FL.IconFont                Segoe Fluent Icons (Windows 11) with Segoe MDL2 Assets fallback
  Styles (keyed, opt-in)
    FL.ToggleSwitch  (CheckBox: label left, switch right, like a macOS Form toggle)
    FL.ComboBox      (with its item style)
    FL.Button / FL.AccentButton
    FL.SectionHeader (TextBlock above a card)   FL.SectionCard (Border)   FL.FooterText (TextBlock)
    FL.ContextMenu   (dark rounded menu; its MenuItems and Separators are styled implicitly)
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="FL.WindowBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="FL.SurfaceBackground" Color="#282828"/>
    <SolidColorBrush x:Key="FL.SurfaceBorder" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="FL.ControlBackground" Color="#363636"/>
    <SolidColorBrush x:Key="FL.ControlHoverBackground" Color="#424242"/>
    <SolidColorBrush x:Key="FL.ControlBorder" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="FL.TextPrimary" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="FL.TextSecondary" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="FL.TextTertiary" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="FL.Separator" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="FL.MenuBackground" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="FL.MenuHover" Color="#0A84FF"/>
    <SolidColorBrush x:Key="FL.Accent" Color="#0A84FF"/>
    <SolidColorBrush x:Key="FL.AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FL.SwitchOffTrack" Color="#4A4A4A"/>

    <SolidColorBrush x:Key="FL.Ink" Color="#131313"/>
    <SolidColorBrush x:Key="FL.Mid" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="FL.Light" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="FL.Danger" Color="#FF453A"/>
    <SolidColorBrush x:Key="FL.Success" Color="#6BD46A"/>

    <FontFamily x:Key="FL.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Text -->
    <Style x:Key="FL.SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource FL.TextSecondary}"/>
        <Setter Property="Margin" Value="10,14,0,6"/>
    </Style>
    <Style x:Key="FL.FooterText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource FL.TextSecondary}"/>
        <Setter Property="Margin" Value="10,6,10,0"/>
    </Style>
    <Style x:Key="FL.SectionCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FL.SurfaceBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FL.SurfaceBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,4"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="FL.Button" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource FL.TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource FL.ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FL.ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FL.ControlHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FL.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FL.AccentButton" TargetType="Button" BasedOn="{StaticResource FL.Button}">
        <Setter Property="Background" Value="{DynamicResource FL.Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FL.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource FL.AccentText}"/>
    </Style>

    <!-- Toggle switch (CheckBox) -->
    <Style x:Key="FL.ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource FL.TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="0,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" RecognizesAccessKey="True"/>
                        <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11"
                                Background="{DynamicResource FL.SwitchOffTrack}" VerticalAlignment="Center">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.3"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource FL.Accent}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource FL.Accent}"/>
                            <Setter TargetName="Track" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style x:Key="FL.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource FL.TextPrimary}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="3,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FL.ControlHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FL.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource FL.AccentText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FL.ComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource FL.TextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource FL.ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FL.ControlBorder}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource FL.ComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="6" BorderThickness="1"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                        <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource FL.IconFont}" FontSize="9"
                                                   Foreground="{DynamicResource FL.TextSecondary}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FL.ControlHoverBackground}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="10,4,28,4" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{DynamicResource FL.MenuBackground}" BorderBrush="{DynamicResource FL.SurfaceBorder}"
                                    BorderThickness="1" CornerRadius="8" Padding="0,4" Margin="0,0,6,6"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FL.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Context menu (tray) -->
    <Style x:Key="FL.MenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource FL.TextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="6,4,8,4" Margin="5,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="IconHost" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="36,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource FL.TextSecondary}"/>
                            <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;" FontFamily="{DynamicResource FL.IconFont}" FontSize="9"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed"/>
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="6" VerticalOffset="-6" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource FL.MenuBackground}" BorderBrush="{DynamicResource FL.SurfaceBorder}"
                                        BorderThickness="1" CornerRadius="8" Padding="0,5" Margin="0,0,8,8" MinWidth="140">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4"/>
                                    </Border.Effect>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FL.MenuHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource FL.AccentText}"/>
                            <Setter TargetName="Gesture" Property="Foreground" Value="{DynamicResource FL.AccentText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FL.ContextMenu" TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource FL.TextPrimary}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource FL.MenuBackground}" BorderBrush="{DynamicResource FL.SurfaceBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="0,5" Margin="0,0,10,10" MinWidth="230">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45"/>
                        </Border.Effect>
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style TargetType="MenuItem" BasedOn="{StaticResource FL.MenuItem}"/>
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Margin="12,5" Background="{DynamicResource FL.Separator}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>
</ResourceDictionary>
