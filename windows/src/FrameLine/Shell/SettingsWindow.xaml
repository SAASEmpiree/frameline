<Window x:Class="FrameLine.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrameLine"
        SizeToContent="Height" Width="556"
        ResizeMode="CanMinimize" ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        Background="{DynamicResource FL.WindowBackground}"
        Foreground="{DynamicResource FL.TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="pack://application:,,,/Assets/FrameLine.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <!-- Preference toolbar: icon above label, one item per tab (NSToolbar .preference). -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource FL.Separator}" BorderThickness="0,0,0,1" Padding="0,8,0,6">
            <StackPanel x:Name="Toolbar" Orientation="Horizontal" HorizontalAlignment="Center"/>
        </Border>
        <ScrollViewer x:Name="PaneHost" Height="580" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" Padding="20,4,20,16"/>
    </DockPanel>
</Window>
